{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-release",
      "displayName": "vision Windows x64 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{VISION_QT_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "jobs": 2
    }
  ]
}
